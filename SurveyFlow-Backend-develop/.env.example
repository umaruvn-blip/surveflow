# ========== General ==========
APP_NAME=survey-flow
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/

# ========== Database / Migration ==========
POSTGRES_DB=survey_flow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/survey_flow
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_OPEN_IN_VIEW=false

# ========== Frontend / CORS ==========
FRONTEND_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/callback
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_CORS_ALLOWED_HEADERS=*
APP_CORS_EXPOSED_HEADERS=Authorization,Content-Disposition
APP_CORS_ALLOW_CREDENTIALS=true
APP_CORS_MAX_AGE=3600

# ========== Swagger / OpenAPI (Global) ==========
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_API_DOCS_PATH=/v3/api-docs
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html
SPRINGDOC_SWAGGER_UI_SORTER=alpha

# ========== Swagger / OpenAPI (Per Profile) ==========
SPRINGDOC_API_DOCS_ENABLED_DEV=true
SPRINGDOC_API_DOCS_ENABLED_TEST=true
SPRINGDOC_API_DOCS_ENABLED_PROD=true
SPRINGDOC_SWAGGER_UI_ENABLED_PROD=false

# ========== Swagger Info ==========
APP_SWAGGER_TITLE=Survey Flow API
APP_SWAGGER_VERSION=v1
APP_SWAGGER_DESCRIPTION=Backend API for Survey Flow
APP_SWAGGER_DESCRIPTION_DEV=API docs for development environment
APP_SWAGGER_DESCRIPTION_TEST=API docs for test environment
APP_SWAGGER_DESCRIPTION_PROD=API docs for production environment
APP_SWAGGER_CONTACT_NAME=Survey Flow Team
APP_SWAGGER_CONTACT_EMAIL=support@surveyflow.com

# ========== JWT ==========
APP_JWT_ACCESS_TOKEN_SECRET=VGhpc0lzQVRlbXBsYXRlQWNjZXNzVG9rZW5TZWNyZXRLZXlTaG91bGRCZUF0TGVhc3QzMkJ5dGVz
APP_JWT_REFRESH_TOKEN_SECRET=VGhpc0lzQVRlbXBsYXRlUmVmcmVzaFRva2VuU2VjcmV0S2V5U2hvdWxkQmVBdExlYXN0MzJCeXRlcw==
APP_JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
APP_JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
APP_JWT_REFRESH_TOKEN_COOKIE_NAME=refreshToken
APP_JWT_REFRESH_TOKEN_COOKIE_SECURE=false
APP_JWT_REFRESH_TOKEN_COOKIE_SAME_SITE=Strict

# ========== AI Matching Service ==========
AI_MATCHING_SERVICE_URL=http://localhost:8000
AI_MATCHING_PORT=8000
AI_MATCHING_DEFAULT_TOP_K=10
AI_MATCHING_TIMEOUT_MS=5000

# ========== Logging ==========
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=DEBUG
LOGGING_LEVEL_ROOT_DEV=INFO
LOGGING_LEVEL_APP_DEV=DEBUG
LOGGING_LEVEL_ROOT_TEST=INFO
LOGGING_LEVEL_APP_TEST=DEBUG
LOGGING_LEVEL_ROOT_PROD=WARN
LOGGING_LEVEL_APP_PROD=INFO
